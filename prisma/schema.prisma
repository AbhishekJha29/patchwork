generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String      @id @default(cuid())
  name              String?
  email             String      @unique
  password          String
  createdAt         DateTime    @default(now())
  incidentsAssigned Incident[]  @relation("AssignedIncidents")
  orgMemberships    OrgMember[]
}

model Org {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  createdAt            DateTime              @default(now())
  notificationLogs     NotificationLog[]
  notificationSettings NotificationSettings?
  members              OrgMember[]
  projects             Project[]
}

model NotificationSettings {
  id                     String   @id @default(cuid())
  orgId                  String   @unique
  slackWebhookUrl        String?
  emailEnabled           Boolean  @default(false)
  slackEnabled           Boolean  @default(false)
  notifyCriticalIncident Boolean  @default(true)
  notifyReviewOpened     Boolean  @default(true)
  notifyResolved         Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  org                    Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id           String               @id @default(cuid())
  orgId        String
  provider     NotificationProvider
  eventType    String
  recipient    String?
  success      Boolean
  errorMessage String?
  timestamp    DateTime             @default(now())
  org          Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model OrgMember {
  id       String   @id @default(cuid())
  userId   String
  orgId    String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())
  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model Project {
  id                        String     @id @default(cuid())
  orgId                     String
  name                      String
  repoUrl                   String
  createdAt                 DateTime   @default(now())
  deploymentTrackingEnabled Boolean    @default(false)
  apiKeys                   ApiKey[]
  incidents                 Incident[]
  org                       Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Incident {
  id                String       @id @default(cuid())
  projectId         String
  title             String
  severity          Severity     @default(MEDIUM)
  status            Status       @default(DETECTED)
  errorMessage      String
  aiSummary         String?
  assigneeId        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  fingerprint       String?
  lastSeenAt        DateTime     @default(now())
  occurrenceCount   Int          @default(1)
  aiTags            String[]     @default([])
  triagedAt         DateTime?
  rootCauseCommitId String?      @unique
  auditLogs         AuditLog[]
  commits           Commit[]     @relation("IncidentCandidateCommits")
  fixes             Fix[]
  assignee          User?        @relation("AssignedIncidents", fields: [assigneeId], references: [id])
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rootCauseCommit   Commit?      @relation("RootCauseCommit", fields: [rootCauseCommitId], references: [id])
  stackFrames       StackFrame[]

  @@index([projectId, fingerprint])
}

model ApiKey {
  id         String    @id @default(cuid())
  projectId  String
  key        String    @unique
  name       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revoked    Boolean   @default(false)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model StackFrame {
  id           String   @id @default(cuid())
  incidentId   String
  filePath     String
  lineNumber   Int
  functionName String
  order        Int
  incident     Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model Commit {
  id                   String    @id @default(cuid())
  incidentId           String?
  hash                 String
  author               String
  message              String
  timestamp            DateTime
  confidenceScore      Float?
  reasoning            String?
  incident             Incident? @relation("IncidentCandidateCommits", fields: [incidentId], references: [id], onDelete: Cascade)
  rootCauseForIncident Incident? @relation("RootCauseCommit")
}

model Fix {
  id            String    @id @default(cuid())
  incidentId    String
  diff          String
  prUrl         String?
  prDescription String?
  createdAt     DateTime  @default(now())
  branchName    String?
  prTitle       String?
  status        FixStatus @default(DRAFT)
  deployedAt    DateTime?
  mergedAt      DateTime?
  prNumber      Int?
  incident      Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  incidentId String
  type       String
  message    String
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum Status {
  DETECTED
  TRIAGED
  ANALYZING
  FIX_GENERATED
  IN_REVIEW
  DEPLOYED
  RESOLVED
}

enum NotificationProvider {
  SLACK
  EMAIL
}

enum FixStatus {
  DRAFT
  PR_OPENED
  FAILED
}
